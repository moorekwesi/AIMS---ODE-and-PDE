FTCS, N = 20 (B symmetric, so ||B^n||_2 = rho(B)^n):
   r = 0.40: rho(B) = 0.9902, ||B||_2 = 0.9902, ||B||_inf = 1.0000
   r = 0.50: rho(B) = 0.9877, ||B||_2 = 0.9877, ||B||_inf = 1.0000
   r = 0.51: rho(B) = 1.0274, ||B||_2 = 1.0274, ||B||_inf = 1.0400
   r = 0.60: rho(B) = 1.3852, ||B||_2 = 1.3852, ||B||_inf = 1.4000
upwind, N = 50 (B non-normal, all eigenvalues equal 1 - nu):
   nu = 0.8: rho(B) = 0.20, ||B^n||_2 at n = 10, 50, 150: 9.96e-01, 8.34e-01, 4.57e-36
   nu = 1.5: rho(B) = 0.50, ||B^n||_2 at n = 10, 50, 150: 1.02e+03, 9.70e+14, 1.71e+18
