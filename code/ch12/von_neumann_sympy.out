FTCS            g = -4*S*r + 1
                1 - |g|^2 = -8*S*r*(2*S*r - 1)
BTCS            g = 1/(4*S*r + 1)
                1 - |g|^2 = 8*S*r*(2*S*r + 1)/(4*S*r + 1)**2
Crank-Nicolson  g = -(2*S*r - 1)/(2*S*r + 1)
                1 - |g|^2 = 8*S*r/(2*S*r + 1)**2
upwind          g = -2*S*nu - I*nu*sin(theta) + 1
                1 - |g|^2 = -4*S*nu*(nu - 1)
Lax-Friedrichs  g = -2*S - I*nu*sin(theta) + 1
                1 - |g|^2 = 4*S*(S - 1)*(nu - 1)*(nu + 1)
Lax-Wendroff    g = -2*S*nu**2 - I*nu*sin(theta) + 1
                1 - |g|^2 = -4*S**2*nu**2*(nu - 1)*(nu + 1)
leapfrog (transport): g**2 + 2*I*g*nu*sin(theta) - 1 = 0
leapfrog (wave): g**2 + g*(4*S*nu**2 - 2) + 1 = 0
